# Multi-stage build for Lambda functions - Lambda-compatible version
FROM golang:1.24-alpine AS builder

# Install build dependencies
RUN apk add --no-cache git ca-certificates tzdata

# Set working directory
WORKDIR /app

# Copy go mod files
COPY go.mod go.sum ./

# Download dependencies
RUN go mod download

# Copy source code
COPY . .

# Build the application
# FUNCTION_NAME will be passed during build
ARG FUNCTION_NAME
RUN if [ -z "$FUNCTION_NAME" ]; then \
        echo "Error: FUNCTION_NAME build argument is required"; \
        exit 1; \
    fi

# Build with specific flags for Lambda compatibility
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build \
    -ldflags="-s -w" \
    -o bootstrap \
    functions/$FUNCTION_NAME/main.go

# Runtime stage - use Lambda-provided al2023 base image
FROM public.ecr.aws/lambda/provided:al2023

# Copy only the binary from builder stage
COPY --from=builder /app/bootstrap ${LAMBDA_RUNTIME_DIR}/bootstrap

# Set proper permissions
RUN chmod +x ${LAMBDA_RUNTIME_DIR}/bootstrap

# Set the CMD to your handler
CMD [ "bootstrap" ] 