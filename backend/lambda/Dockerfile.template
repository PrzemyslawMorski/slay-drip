# Multi-stage build for the Slay Drip API container (Scaleway Serverless Containers).
FROM golang:1.25-alpine AS builder

# Install build dependencies
RUN apk add --no-cache git ca-certificates tzdata

# Set working directory
WORKDIR /app

# Copy go mod files
COPY go.mod go.sum ./

# Download dependencies
RUN go mod download

# Copy source code
COPY . .

# Build a static binary for the API entrypoint
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build \
    -ldflags="-s -w" \
    -o /app/api \
    ./functions/api

# Runtime stage: minimal image with CA certificates (needed for TLS to the database)
FROM alpine:3.20

RUN apk add --no-cache ca-certificates tzdata \
    && addgroup -S app \
    && adduser -S -G app app

COPY --from=builder /app/api /usr/local/bin/api

USER app

# Scaleway injects PORT; the API listens on it (default 8080)
EXPOSE 8080

ENTRYPOINT ["/usr/local/bin/api"]
