# Multi-stage build for Lambda functions - Ultra minimal version
FROM golang:1.24-alpine AS builder

# Install build dependencies
RUN apk add --no-cache git ca-certificates tzdata

# Set working directory
WORKDIR /app

# Copy go mod files
COPY go.mod go.sum ./

# Download dependencies
RUN go mod download

# Copy source code
COPY . .

# Build the application
# FUNCTION_NAME will be passed during build
ARG FUNCTION_NAME
RUN if [ -z "$FUNCTION_NAME" ]; then \
        echo "Error: FUNCTION_NAME build argument is required"; \
        exit 1; \
    fi

# Build with specific flags for Lambda compatibility
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build \
    -ldflags="-s -w" \
    -o bootstrap \
    functions/$FUNCTION_NAME/main.go

# Runtime stage - use minimal alpine base
FROM alpine:latest

# Install runtime dependencies
RUN apk add --no-cache ca-certificates tzdata

# Create Lambda runtime directory structure
RUN mkdir -p /var/runtime

# Copy only the binary from builder stage
COPY --from=builder /app/bootstrap /var/runtime/bootstrap

# Set proper permissions
RUN chmod +x /var/runtime/bootstrap

# Set the CMD to your handler
CMD [ "/var/runtime/bootstrap" ] 